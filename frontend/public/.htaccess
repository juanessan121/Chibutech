# Chibutech — frontend (React SPA con React Router)
# Reenvía cualquier ruta que no sea un archivo/carpeta real hacia index.html,
# para que recargar la página en rutas como /dashboard/usuarios no dé 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Evita que se liste el contenido de las carpetas si falta un index
Options -Indexes
