# ══════════════════════════════════════════════════════
#  CHIBUTECH — Variables de entorno
#  Copia este archivo: cp .env.example .env
#  El archivo .env NUNCA se sube al repositorio
# ══════════════════════════════════════════════════════

# ── Aplicación ─────────────────────────────────────────
APP_NAME=Chibutech
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ── Base de datos ───────────────────────────────────────
DB_DATABASE=chibutec_dev
DB_USERNAME=chibu_user
DB_PASSWORD=chibu_password
DB_ROOT_PASSWORD=root_super_secreto
DB_EXTERNAL_PORT=3306

# ── Puertos de servicios ────────────────────────────────
NGINX_PORT=80
PMA_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── Sanctum ─────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173

# ── Swagger ─────────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true

# ── Logs ────────────────────────────────────────────────
LOG_LEVEL=debug
